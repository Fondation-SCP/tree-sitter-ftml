{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "ftml",
      "camelcase": "Ftml",
      "title": "Wikidot syntax",
      "scope": "source.ftml",
      "file-types": [
        "ftml"
      ],
      "injection-regex": "^ftml$",
      "class-name": "TreeSitterFtml"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "AGPL-3.0",
    "description": "Wikidot syntax",
    "authors": [
      {
        "name": "sty"
      }
    ],
    "links": {
      "repository": "https://github.com/Fondation-SCP/tree-sitter-ftml",
      "funding": ""
    }
  },
  "bindings": {
    "c": false,
    "go": false,
    "java": false,
    "node": false,
    "python": false,
    "rust": true,
    "swift": false,
    "zig": false
  }
}